#!/bin/bash

# === Defaults ===
Mask="D*NEF"
Folder="." 

# === Parse args ===
while [[ $# -gt 0 ]]; do
  case "$1" in
    --mask|-m)
      Mask="$2"
      shift 2
      ;;
    --folder|-f)
      Folder="$2"
      shift 2
      ;;
    --help|-h)
      echo "Usage: $0 [--mask <pattern>] [--folder <path>]"
      echo "Example: $0 --mask 'D*NEF' --folder '/tmp/DSC/'"
      exit 0
      ;;
    *)
      echo "❌ Unexpected argument: $1"
      echo "Try: $0 --help"
      exit 1
      ;;
  esac
done

# === Main function ===
MainRun() {
  Folder="${Folder%/}"

  local Files=("$Folder"/$Mask)
  local CounterT=${#Files[@]}
  local C=0

  echo "📂 Folder: $Folder"
  echo "🔍 Found $CounterT files matching: $Mask"
  echo

  echo  "List of files:"
  echo " ${Files[@]}"
  echo "======"

  for f in "${Files[@]}"; do
    [ -e "$f" ] || continue
    [ -d "$f" ] && continue
    ((C++))
    printf "[%02d/%02d] %s\n" "$C" "$CounterT" "$f"

    datetime=$(exiftool -s -s -s -DateTimeOriginal "$f" | tr ' :|' '.')
    if [ -n "$datetime" ]; then
      basename=$(basename "$f")
      newname="${Folder}/${datetime}_${basename}"
      mv -v "$f" "$newname"
    else
      echo "⚠️  No EXIF date for $f"
    fi
  done
}

MainRun
