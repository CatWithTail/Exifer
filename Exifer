#!/bin/bash

# === Defaults ===

Mask="D*NEF"
Folder="." 
Recursive="-maxdepth 1"
Debug=false
DryRun=false

Tools="mdls exiftool"

# === Functions ===

GetHelp() {
  echo "Usage: $0 [--mask <pattern>] [--folder <path>]"
  echo "Examples:"
  echo "  $0                         # Run in the current folder only, filemask is $Mask"
  echo "  $0 --mask|m '"$Mask"'        # Run for $Mask files in the $Folder folder"
  echo "  $0 --recursive|-R          # Recursive run, subfolders will be affected"
  echo "  $0 --folder|-f $Folder           # $Mask in $Folder folder"
  echo "  $0 --dry-run|-n            # DryRun"
  echo "  $0 --help|-h               # Print this Help"
  echo "  $0 --debug                 # Could be helpful in case of bad file naming"
  exit 0
}

CheckUtils() {
  if command -v $1 >/dev/null 2>&1;
    then
      echo "$1 found."
      Util=$1
      break
    else
      echo "$1 not found"
  fi
}

GetUtil() {
  for Tool in $Tools; do 
    CheckUtils $Tool
  done
  if [[ -z $Util ]];
    then
      echo "No one utuil from the list:"
      echo "    $Tools"
      echo "has been found"
      echo ""
      echo "Have one of them installed before the next run, please!"
      echo ""
      exit 1
  fi
}

GetDate() {
  case "$Util" in
    exiftool)
      exiftool -s -s -s -DateTimeOriginal "$1" | tr ' :|' '.'
      ;;
    mdls)
      mdls -raw -name kMDItemContentCreationDate "$1" | cut -f 1,2 -d " "  | tr ' :|-' '.'
      ;;
    *)
      echo "❌ Can't get a data from exif"
      exit 1
      ;;
  esac
}

GetTheFileList() 
{
  Folder="${Folder%/}"
  echo "Looking for $Mask files in $Folder ..."
  FileList=$(find $Folder $Recursive -name "$Mask")
  TotalFiles=$(echo "$FileList" | wc -w | tr -s ' ')
  echo "Found:      $TotalFiles"
}

ProcessingFiles()
{
  local C=0
  local newname=""
  for f in $FileList
    do
      ((C++))
      ExifDate=$(GetDate $f)
      if [ -n "$ExifDate" ]
        then
          if $Debug
            then
              echo "$C of $TotalFiles - $f"
              echo "Debug info:"
              echo "Filename is $(dirname $f)"
              echo "ExifDate is ${ExifDate}"
              echo "Basename is $(basename $f)"
              echo "***"
          fi
          newname="$(dirname $f)/${ExifDate}_$(basename $f)"
          if $DryRun
            then
              echo "$C  of $TotalFiles : $f 👉 Would rename to: $newname"
            else
              mv -v $f $newname
          fi
        else
          echo "⚠️  No EXIF date for $f"
      fi
  done
}

# === Parse args ===
while [[ $# -gt 0 ]]; do
  case "$1" in
    --mask|-m)
      Mask="$2"
      shift 2
      ;;
    --folder|-f)
      Folder="$2"
      shift 2
      ;;
    --dry-run|-n)
      DryRun=true
      shift
      ;;
    --recursive|-R)
      Recursive=""
      shift
      ;;
    --debug)
      Debug=true
      shift
      ;;
    --help|-h)
      GetHelp
      ;;
    *)
      echo "❌ Unexpected argument: $1"
      echo "Try: $0 --help"
      exit 1
      ;;
  esac
done

# === Main function ===
MainRun() {
  GetUtil
  GetTheFileList
  ProcessingFiles
}

MainRun
